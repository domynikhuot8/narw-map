                dashArray: '',
                lineCap: 'butt',
                lineJoin: 'miter',
                weight: 1,
                fill: true,
                fillOpacity: 1,
                fillColor: 'rgba(140,140,140,1.0)',
                interactive: true,
            };
                }
                else if (exp_WhaleDetections_12rule5_eval_expression(context)) {
                  return {
