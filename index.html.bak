            };
            // Start of if blocks and style check logic
            if (exp_PossibleNARWSatelliteDetection_11rule0_eval_expression(context)) {
                  return {
                pane: 'pane_PossibleNARWSatelliteDetection_11',
                shape: 'x',
                radius: 10.0,
                opacity: 1,
                color: 'rgba(214,40,40,1.0)',
                dashArray: '',
                lineCap: 'butt',
                lineJoin: 'miter',
                weight: 2.0,
                fill: true,
                fillOpacity: 1,
                fillColor: 'rgba(214,40,40,1.0)',
                interactive: true,
            };
                }
                else if (exp_PossibleNARWSatelliteDetection_11rule1_eval_expression(context)) {
                  return {
                pane: 'pane_PossibleNARWSatelliteDetection_11',
                shape: 'x',
                radius: 10.0,
                opacity: 1,
                color: 'rgba(255,209,26,1.0)',
                dashArray: '',
                lineCap: 'butt',
                lineJoin: 'miter',
                weight: 2.0,
                fill: true,
                fillOpacity: 1,
                fillColor: 'rgba(255,209,26,1.0)',
                interactive: true,
            };
                }
                else if (exp_PossibleNARWSatelliteDetection_11rule2_eval_expression(context)) {
                  return {
                pane: 'pane_PossibleNARWSatelliteDetection_11',
                shape: 'x',
                radius: 10.0,
                opacity: 1,
                color: 'rgba(140,140,140,1.0)',
                dashArray: '',
                lineCap: 'butt',
                lineJoin: 'miter',
                weight: 2.0,
                fill: true,
                fillOpacity: 1,
                fillColor: 'rgba(255,255,255,1.0)',
                interactive: true,
            };
                }
            else {
                return {fill: false, stroke: false};
            }
        }
        map.createPane('pane_PossibleNARWSatelliteDetection_11');
        map.getPane('pane_PossibleNARWSatelliteDetection_11').style.zIndex = 411;
        map.getPane('pane_PossibleNARWSatelliteDetection_11').style['mix-blend-mode'] = 'normal';
        var layer_PossibleNARWSatelliteDetection_11 = new L.geoJson(json_PossibleNARWSatelliteDetection_11, {
            attribution: '',
            interactive: true,
            dataVar: 'json_PossibleNARWSatelliteDetection_11',
            layerName: 'layer_PossibleNARWSatelliteDetection_11',
