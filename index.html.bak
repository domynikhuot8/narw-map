                opacity: 1,
                color: 'rgba(0,0,0,1.0)',
                dashArray: '',
                lineCap: 'butt',
                lineJoin: 'miter',
                weight: 1.0,
                fill: true,
                fillOpacity: 1,
                fillColor: 'rgba(214,40,40,1.0)',
                interactive: true,
            };
                }
                else if (exp_WhaleDetections_12rule4_eval_expression(context)) {
                  return {
