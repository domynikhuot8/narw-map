                    </tr>\
                    <tr>\
                        <th scope="row">length_meters</th>\
                        <td>' + (feature.properties['length_meters'] !== null ? autolinker.link(String(feature.properties['length_meters']).replace(/'/g, '\'').toLocaleString()) : '') + '</td>\
                    </tr>\
                    <tr>\
                        <th scope="row">notes</th>\
