        map.getPane('pane_7Sept2026_2').style.zIndex = 402;
        var img_7Sept2026_2 = 'data/7Sept2026_2.png';
        var img_bounds_7Sept2026_2 = [[48.490656714359076,-65.5303122393657],[49.995018902495055,-63.37915622624127]];
        var layer_7Sept2026_2 = new L.imageOverlay(img_7Sept2026_2,
                                              img_bounds_7Sept2026_2,
                                              {pane: 'pane_7Sept2026_2'});
        bounds_group.addLayer(layer_7Sept2026_2);
        map.addLayer(layer_7Sept2026_2);
        map.createPane('pane_12Sept2026_3');
        map.getPane('pane_12Sept2026_3').style.zIndex = 403;
        var img_12Sept2026_3 = 'data/12Sept2026_3.png';
        var img_bounds_12Sept2026_3 = [[48.81608180088847,-66.13346098151067],[50.16575947843791,-63.98421270980256]];
