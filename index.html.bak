        function pop_SatellitefootprintsPNEO1Sep2026_4(feature, layer) {
            layer.on({
                mouseout: function(e) {
                    if (typeof layer.closePopup == 'function') {
                        layer.closePopup();
                    } else {
                        layer.eachLayer(function(feature){
                            feature.closePopup()
                        });
                    }
                },
                mouseover: highlightFeature,
            });
            var popupContent = '<table>\
                    <tr>\
                        <th scope="row">sensor</th>\
                        <td>' + (feature.properties['sensor'] !== null ? autolinker.link(String(feature.properties['sensor']).replace(/'/g, '\'').toLocaleString()) : '') + '</td>\
                    </tr>\
                    <tr>\
                        <th scope="row">date</th>\
                        <td>' + (feature.properties['date'] !== null ? autolinker.link(String(feature.properties['date']).replace(/'/g, '\'').toLocaleString()) : '') + '</td>\
                    </tr>\
                </table>';
            var content = removeEmptyRowsFromPopupContent(popupContent, feature);
			layer.on('popupopen', function(e) {
				addClassToPopupIfMedia(content, e.popup);
			});
			layer.bindPopup(content, { maxHeight: 400 });
        }
        function style_SatellitefootprintsPNEO1Sep2026_4_0(feature) {
            var context = {
                feature: feature,
                variables: {}
            };
            // Start of if blocks and style check logic
            if (exp_SatellitefootprintsPNEO1Sep2026_4rule0_eval_expression(context)) {
                  return {
                pane: 'pane_SatellitefootprintsPNEO1Sep2026_4',
                opacity: 1,
                color: 'rgba(51,160,44,1.0)',
                dashArray: '',
                lineCap: 'butt',
                lineJoin: 'miter',
                weight: 2.0, 
                fillOpacity: 0,
                interactive: true,
            };
                }
            else {
                return {fill: false, stroke: false};
            }
        }
        map.createPane('pane_SatellitefootprintsPNEO1Sep2026_4');
        map.getPane('pane_SatellitefootprintsPNEO1Sep2026_4').style.zIndex = 404;
        map.getPane('pane_SatellitefootprintsPNEO1Sep2026_4').style['mix-blend-mode'] = 'normal';
        var layer_SatellitefootprintsPNEO1Sep2026_4 = new L.geoJson(json_SatellitefootprintsPNEO1Sep2026_4, {
